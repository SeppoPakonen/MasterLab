acceptflags GUI;\ndescription "Cubase-style VST Connections window scaffolding";

uses
	CtrlLib,
	Devices,
	Windowing,
	ProjectMgmt,
	AudioCore,
	Tooling;

file
	AGENTS.md,
	VSTConnectionsCtrl.h,
	VSTConnectionsCtrl.cpp,
	VSTConnectionsPresenter.h,
	VSTConnectionsPresenter.cpp,
	VSTConnectionsWnd.h,
	VSTConnectionsWnd.cpp,
	CuteAudioIOMatrixForm.h,
	CuteAudioIOMatrixForm.cpp,
	CuteAudioIOMatrixFormLayout.md,
	CuteBusForm.h,
	CuteBusForm.cpp,
	CuteBusFormLayout.md,
	CuteConnect.h,
	CuteConnect.cpp,
	CuteConnectForm.h,
	CuteConnectForm.cpp,
	CuteConnectFormLayout.md,
	CuteConnections.h,
	CuteConnections.cpp;

mainconfig "Standalone" = "GUI", "Headless" = "!GUI"

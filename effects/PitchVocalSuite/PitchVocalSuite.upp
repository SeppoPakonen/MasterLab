description "Effect Plugin: Pitch Vocal Suite\377200,200,200";

uses
	PluginSDK,
	PluginABI/LV2,
	AudioCore,
	AudioAnalysis,
	DSP;

uses(GUI) CtrlLib;
uses(GUI) AudioUI;
uses(GUI) SoftAudio;
uses(GUI) AI/LogicGui;
uses(GUI) CtrlLog;

uses(BUILTIN_PORTAUDIO) plugin/portaudio;

file
	AGENTS.md,
	PitchVocalSuite.h,
	PitchVocalSuite.cpp;

mainconfig
	"Standalone" = "GUI BUILTIN_PORTAUDIO",
	"Headless" = "BUILTIN_PORTAUDIO",
	"LV2" = "GUI DLL BUILTIN_PORTAUDIO";
